{
  "title": "Automatic Pipelines per Process (end-to-end, no manual steps)",
  "note": "Each pipeline runs automatically on a trigger. Status: automatic = full chain runs end-to-end via one call; semi = some manual input; planned = not wired.",
  "updated_at": "2026-06-23",
  "pipelines": [
    {"process": "EEG Analysis", "trigger": "EEG file upload", "endpoint": "POST /api/analyze-upload",
     "stages": ["parse EDF/CSV", "47-feature extract", "signal analysis (bands/quality)", "trained model predict", "write report", "persist + audit"],
     "status": "automatic"},
    {"process": "Patient Master Data", "trigger": "multi-file upload", "endpoint": "POST /api/patient-master/ingest",
     "stages": ["route by type", "extract (video/pdf/image/edf/docx)", "build master_data.json", "DB registry", "transaction log"],
     "status": "automatic"},
    {"process": "Multi-Disease Accuracy", "trigger": "scheduled / on-demand", "endpoint": "scripts/test_multi_disease_accuracy.py",
     "stages": ["load models", "load samples", "predict", "metrics (acc/F1/confusion)", "write report"],
     "status": "automatic"},
    {"process": "Subject-wise Eval", "trigger": "on-demand", "endpoint": "scripts/test_subjectwise_accuracy.py",
     "stages": ["group by subject", "GroupKFold", "fresh model per fold", "leakage-free metrics", "report"],
     "status": "automatic"},
    {"process": "Cross-Patient Benchmark", "trigger": "on-demand", "endpoint": "scripts/cross_patient_benchmark.py",
     "stages": ["parse seizure annotations", "extract windows per subject", "leave-one-subject-out", "RF train/test", "report"],
     "status": "automatic"},
    {"process": "Deep Learning", "trigger": "on-demand", "endpoint": "GET /api/deep-train/{disease}",
     "stages": ["load features", "scale", "torch DNN train (subject-wise)", "CV metrics"],
     "status": "automatic"},
    {"process": "Model Lab (selection)", "trigger": "on-demand", "endpoint": "GET /api/modellab/{disease}/*",
     "stages": ["SMOTE balance", "feature selection (corr)", "RF/XGBoost/LightGBM compare", "PCA reduce"],
     "status": "automatic"},
    {"process": "Anomaly Detection", "trigger": "on-demand", "endpoint": "GET /api/anomaly/{disease}",
     "stages": ["scale", "Isolation Forest", "LOF", "One-Class SVM", "consensus"],
     "status": "automatic"},
    {"process": "Time-Series + Stats", "trigger": "on-demand", "endpoint": "GET /api/timeseries|statistics/{disease}",
     "stages": ["ADF stationarity", "band-over-time", "change-point", "per-feature t-test/Mann-Whitney + Cohen's d"],
     "status": "automatic"},
    {"process": "Explainability (SHAP)", "trigger": "on-demand", "endpoint": "GET /api/explain/{disease}",
     "stages": ["load model+sample", "SHAP TreeExplainer", "global importance", "per-prediction", "expert concordance"],
     "status": "automatic"},
    {"process": "Interpretable AI", "trigger": "on-demand", "endpoint": "GET /api/interpret/{disease}",
     "stages": ["train surrogate tree", "fidelity vs black-box", "rule extraction"],
     "status": "automatic"},
    {"process": "Responsible AI", "trigger": "on-demand", "endpoint": "GET /api/responsible-ai/{disease}",
     "stages": ["fairness (DI/EO)", "PII scan", "injection scan", "per-phase report"],
     "status": "automatic"},
    {"process": "Council of Agents", "trigger": "query", "endpoint": "POST /api/council/run",
     "stages": ["Security gate", "Planner", "RAG retrieve+generate", "Evaluation/decision", "Review/consensus", "Compliance/audit"],
     "status": "automatic"},
    {"process": "Patient Chat (RAG)", "trigger": "query", "endpoint": "POST /api/patient-chat",
     "stages": ["keyword retrieve over records", "Ollama grounded answer", "layout format", "transaction log"],
     "status": "automatic"},
    {"process": "Multi-Agent + MCP", "trigger": "on-demand", "endpoint": "scripts/test_agentic_mcp.py",
     "stages": ["dispatch to 7 disease agents", "collect votes", "MoA aggregate", "A2A + MCP analysis", "report"],
     "status": "automatic"},
    {"process": "Clinical DB Audit", "trigger": "cron (08:00/20:00)", "endpoint": "scripts/clinical_db_audit.py",
     "stages": ["online backup", "count patients/analyses/surveys", "prediction distribution", "write report"],
     "status": "automatic"},
    {"process": "Thesis Asset Collection", "trigger": "cron (09:00/21:00)", "endpoint": "scripts/collect_thesis_assets.py",
     "stages": ["gather figures (pdf/png/svg)", "gather result tables", "write INDEX.md + manifest"],
     "status": "automatic"},
    {"process": "Noise Cleaning (ICA)", "trigger": "on-upload", "endpoint": "GET /api/ica-noise-cleaning/overview",
     "stages": ["load raw", "ICA decompose", "artifact reject", "reconstruct clean"],
     "status": "automatic"},
    {"process": "Seizure Forecasting", "trigger": "on-demand", "endpoint": "GET /api/seizure-forecasting/overview|patients|definitions",
     "stages": ["seizure diary history", "temporal features + risk model", "FAR/hr + sensitivity@horizon", "patient risk profiles", "dashboard"],
     "status": "automatic"},
    {"process": "Continuous Monitoring (IoT)", "trigger": "device stream",
     "endpoint": "POST /api/iot-pipeline/ingest | GET /api/iot-pipeline/simulate|status|log",
     "stages": ["device", "gateway", "ingest", "features (47-dim)", "model (heuristic scorer)", "decision", "SOS alert"],
     "status": "automatic",
     "note": "Full 7-stage pipeline: wearable EEG packet → feature extract → seizure prob scorer → SOS alert if ≥70%. Portal: /iot-pipeline"}
  ]
}
