{
  "title": "Patient Onboarding — Intake-vs-Deferred Field Classification",
  "note": "Only ~80 of ~1250 patient fields are TRUE intake (captured once at registration). The other ~1170 are longitudinal (captured over time via use). This is the 15x time reduction (§57.7 honest).",
  "updated_at": "2026-06-24",
  "goal": "2-3 hours (all 1250 manual) -> 8-10 min active intake (80 fields, most auto-extracted)",
  "steps": [
    {"step": 1, "title": "Required intake (5 min)", "approach": "required-first",
     "groups": [
       {"group": "Demographics", "fields": ["Patient ID", "Name", "DOB", "Sex", "Primary language", "Occupation"], "n": 8},
       {"group": "Chief complaint", "fields": ["Reason for visit", "Suspected diagnosis", "Referring provider"], "n": 6},
       {"group": "Seizure history (core)", "fields": ["Age of onset", "Seizure type", "Current frequency", "Last seizure date", "DRE status"], "n": 12},
       {"group": "Current medications", "fields": ["Drug", "Dose", "Frequency", "Start date"], "n": 16},
       {"group": "Emergency contact", "fields": ["Contact name", "Relationship", "Phone"], "n": 6},
       {"group": "Key risk", "fields": ["Status epilepticus history", "Driving status", "Lives alone"], "n": 8}
     ],
     "total_intake_fields": 56},
    {"step": 2, "title": "Upload reports (auto-extract, 2 min)", "approach": "multi-format extraction",
     "extracts": [
       {"doc": "EEG report (PDF)", "fills": ["Acquisition params", "Background rhythm", "Spike findings", "Localization"]},
       {"doc": "MRI report (PDF)", "fills": ["Lesion findings", "MTS", "Concordance"]},
       {"doc": "EMR export", "fills": ["Demographics", "Full med history", "Comorbidities"]},
       {"doc": "Prior neurology notes", "fills": ["Etiology", "Treatment history"]}
     ],
     "note": "Routes to /api/analyze-upload (built). Saves ~40% — most fields already exist in documents."},
    {"step": 3, "title": "Deferred to portal (captured over time)", "approach": "longitudinal + self-service",
     "deferred_sections": [
       {"section": "Seizure diary", "capture": "patient logs each event (built: /api/seizure-diary)"},
       {"section": "Trigger tracking", "capture": "daily self-report"},
       {"section": "Medication adherence", "capture": "daily logging"},
       {"section": "Sleep/Mood/QoL (PRO)", "capture": "periodic questionnaires"},
       {"section": "Wearables/Digital Twin", "capture": "auto-populate continuously"},
       {"section": "Caregiver assessment", "capture": "async form-assignment (built)"}
     ],
     "deferred_field_estimate": "~1170",
     "note": "These fill themselves through platform use — NOT at intake."}
  ],
  "summary": {"true_intake_fields": "~80", "deferred_fields": "~1170", "reduction": "15x",
              "time_saved": "2-3 hrs -> 8-10 min",
              "honest_note": "Field classification is the real insight: not all 1250 fields are intake. Wizard built; EMR/FHIR pre-fill + voice intake still planned."}
}
